// Staging first. Production (togetherweown.com) is only switched at cutover (plan TOG-9671, W16).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "two-web-next",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Staging database is PlanetScale us-east-1, so this Worker is placed
  // beside it (aws:us-east-1): every statement is a Hyperdrive round trip,
  // and the pre-repoint eu-central-1 pin (beside the retired Neon branch)
  // made each one transatlantic. Live /up from this run's host took 1.32 s
  // under the old pin (2026-10-15); re-measure after the first deploy on
  // this placement before quoting a new figure.
  // env.production opts out below: its database lives elsewhere and that
  // placement is a cutover decision.
  "placement": { "region": "aws:us-east-1" },
  // Deploy the Tail Worker first; it has no public route and its own optional webhook secret.
  "tail_consumers": [{ "service": "two-web-next-alerts" }],
  "workers_dev": false,
  // Preserve unrelated dashboard vars; source vars below override same-name vars.
  // Remote secrets are retained by Wrangler (never copied into source).
  "keep_vars": true,
  // Staging host. The Discord application must list ${APP_URL}/auth/discord/callback as a redirect URI.
  "routes": [{ "pattern": "next.togetherweown.com", "custom_domain": true }],
  // W13: Laravel queue + scheduler parity (TOG-9692). Cron expressions are pinned to
  // src/jobs/constants.ts by test/jobs-constants.test.ts. Staging consumers
  // and crons live on two-web-jobs (wrangler.jobs.jsonc): the web
  // Worker only produces after the handoff, so a queue keeps exactly one
  // consumer and a cron exactly one owner. test/jobs-worker-config.test.ts
  // pins the split. env.production below is produce-only: its consumers and
  // crons live on two-web-jobs-production (wrangler.jobs.jsonc env.production).
  "triggers": { "crons": [] },
  "queues": {
    "producers": [
      { "queue": "two-sync-event", "binding": "SYNC_EVENT_QUEUE" },
      { "queue": "two-internal-action", "binding": "INTERNAL_ACTION_QUEUE" }
    ]
  },
  // Revision marker for `/up` and the release fields on structured log
  // lines. Bindings are not inherited by `env.production`, which declares
  // its own copy below. The deploy workflows tag each Version with its
  // commit SHA; `/up` and the log emitters read it back so a rollback
  // target and every log line's build are provable live.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Every host, including static requests, must pass the Worker's host guard.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  // Shared Postgres: Hyperdrive "two-web-next-staging" → PlanetScale
  // staging branch (direct endpoint). Local dev sets
  // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_DB to agent-testdb.
  "hyperdrive": [
    { "binding": "DB", "id": "1d48a54abd3444009b7067c03c63ff9f" },
    { "binding": "BOT_DB", "id": "63e6e86a91cb4e40b3ee54f459c8b450" }
  ],
  // Not secrets (the client id is public: it is in every OAuth URL). Secrets (DISCORD_CLIENT_SECRET, DISCORD_BOT_TOKEN, SESSION_SECRET) are set with
  // `wrangler secret put` and never live in this file.
  "vars": {
    "APP_URL": "https://next.togetherweown.com",
    // Extra approved image hosts (comma-separated exact DNS names). Empty = Discord CDN only.
    "FEATURED_IMAGE_HOSTS": "",
    "DISCORD_CLIENT_ID": "1539711683898118154",
    "DISCORD_GUILD_ID": "1545644954272137297",
    // Approved staging Owner+Moderator pair only (guild-bound: these IDs exist
    // solely in the staging guild above, never copy the production pair here).
    // Preflight checks this exact public deployment value plus the binding.
    "DISCORD_MODERATOR_ROLE_IDS": "1546211363578191873,1545648550329851946",
    // WEB-HOMEPAGE campaign invite (never expires, unlimited); the fallback when auto-join fails.
    "DISCORD_INVITE_URL": "https://discord.gg/4GwEDNRTtx"
  },
  "env": {
    "production": {
      "name": "two-web-next-production",
      "workers_dev": false,
      // Not inherited from the staging placement above; unchanged until the cutover decision.
      "placement": { "mode": "off" },
      "preview_urls": false,
      // tail_consumers are not inherited from the top level: Wrangler needs
      // this repeated in every named environment that must page.
      "tail_consumers": [{ "service": "two-web-next-alerts-production" }],
      // Not inherited from the top level: without this copy a production
      // `/up` has no revision marker and its log lines carry no build SHA.
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      // Cutover target only, NOT a DNS change or authorization to claim the apex.
      "routes": [{ "pattern": "togetherweown.com", "custom_domain": true }],
      // Produce-only after the production jobs transfer
      // (docs/production-jobs-handoff.md): both production crons and both
      // production consumers live on two-web-jobs-production
      // (wrangler.jobs.jsonc env.production), mirroring the staging split so
      // a queue keeps exactly one consumer and a cron exactly one owner.
      // test/jobs-worker-config.test.ts pins the split.
      "triggers": { "crons": [] },
      // Separate production queues; never reuse staging queues.
      "queues": {
        "producers": [
          { "queue": "two-web-next-production-sync-event", "binding": "SYNC_EVENT_QUEUE" },
          { "queue": "two-web-next-production-internal-action", "binding": "INTERNAL_ACTION_QUEUE" }
        ]
      },
      // Production Hyperdrive for the separately named two-web-next-production
      // database, distinct from staging. The all-zero id is only the inert
      // sentinel ci/production-deploy-gate.mjs refuses; it never lives here.
      // Production database plus read-only bot-reader Hyperdrive binding.
      "hyperdrive": [
        { "binding": "DB", "id": "7489f6ad630042148cdef83602f27b8a" },
        { "binding": "BOT_DB", "id": "14c00d84d1d446c1b117861f3b49473f" }
      ],
      // Vars/bindings do not inherit across environments. No QA_AUTH_TOKEN in prod.
      // env.production.vars must repeat every var the worker reads: Wrangler
      // never inherits top-level vars into a named environment. The moderator
      // list is the approved Owner+Moderator pair for the production guild
      // above, unrelated to staging's pair (role IDs are guild-scoped);
      // without it production boots with no moderators and admin
      // authorization fails closed for everyone.
      "vars": {
        "APP_URL": "https://togetherweown.com",
        "FEATURED_IMAGE_HOSTS": "",
        "DISCORD_CLIENT_ID": "1539711683898118154",
        "DISCORD_GUILD_ID": "326474832151838730",
        // Approved Owner+Moderator pair only. Production preflight checks this exact value.
        "DISCORD_MODERATOR_ROLE_IDS": "1546777855801954408,1546777856984481792",
        "DISCORD_INVITE_URL": "https://discord.gg/4GwEDNRTtx"
      }
    }
  }
}

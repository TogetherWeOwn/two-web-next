#!/usr/bin/env python3
"""Offline PGDG bootstrap regressions: no sudo, apt, network or database access."""
import json
import os
from pathlib import Path
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parent.parent
HELPER = ROOT / "bin/backup-bootstrap.sh"

STUB = r'''#!/usr/bin/env python3
import json, os, pathlib, shutil, subprocess, sys, tempfile
name = pathlib.Path(sys.argv[0]).name
args = sys.argv[1:]
root = pathlib.Path(os.environ["STUB_ROOT"]).resolve()
assert not any(os.isatty(fd) for fd in (0, 1, 2)), "unexpected tty"
with open(root / "calls", "a") as log:
    log.write(json.dumps([name, *args]) + "\n")
mode = os.environ.get("FAIL_AT", "")
def target(value):
    path = pathlib.Path(value)
    assert path.is_absolute() and path.parent.resolve().is_relative_to(root), value
    return path
if name == "sudo":
    assert args.pop(0) == "-n", "sudo must not prompt"
    if args[0] == "env":
        assert args[1] == "DEBIAN_FRONTEND=noninteractive"
        args = args[2:]
    assert args[0] in ("apt-get", "mktemp", "install", "mv", "rm")
    # Never forward sudo or env to a real executable.
    sys.exit(subprocess.call([str(root / "fakebin" / args[0]), *args[1:]]))
elif name == "apt-get":
    countfile = root / "apt-count"
    count = int(countfile.read_text()) + 1 if countfile.exists() else 1
    countfile.write_text(str(count))
    assert "-y" in args
    if mode == f"apt-{count}": sys.exit(31)
elif name == "curl":
    assert args == ["-fsSL", "--output", args[2], "https://www.postgresql.org/media/keys/ACCC4CF8.asc"]
    if mode == "download": sys.exit(32)
    target(args[2]).write_text("invalid" if mode == "invalid-key" else "public-key")
elif name == "gpg":
    if args[:2] == ["--dearmor", "-o"] and target(args[2]).exists():
        print("existing output would prompt without batch overwrite", file=sys.stderr)
        sys.exit(2)
    assert args[:3] == ["--batch", "--yes", "--no-tty"], "gpg must not prompt"
    assert args[3] == "--homedir"
    target(args[4] + "/placeholder")
    if args[5:8] == ["--with-colons", "--with-fingerprint", "--show-keys"]:
        assert len(args) == 9
        if mode == "key-validation" or target(args[8]).read_text() != "public-key": sys.exit(38)
        pinned = "B97B0AFCAA1A47F044F244A07FCC7D46ACCC4CF8"
        other = "1111111111111111111111111111111111111111"
        def block(fpr):
            print("pub:-:4096:1:" + fpr[-16:] + ":1318537154:::-:::scSC::::::23::0:")
            print("fpr" + ":" * 9 + fpr + ":")
        if mode == "wrong-fingerprint":
            block(other)
        else:
            block(pinned)
            if mode == "extra-key": block(other)
        sys.exit(0)
    assert args[5:7] == ["--dearmor", "--output"]
    output, source = target(args[7]), target(args[8])
    if mode == "dearmor" or source.read_text() != "public-key":
        output.write_text("partial-key")
        sys.exit(33)
    output.write_text("" if mode == "empty-key" else "binary-key")
elif name == "mktemp":
    if args == ["-d"]:
        print(tempfile.mkdtemp(dir=root / "scratch"))
    else:
        template = args[0]
        path = target(template)
        assert template.endswith(".tmp.XXXXXX")
        fd, value = tempfile.mkstemp(prefix=path.name[:-6], dir=path.parent)
        os.close(fd)
        print(value)
elif name == "install":
    assert args[:3] == ["-m", "0644", "--"]
    source, dest = target(args[3]), target(args[4])
    if mode == "install" or (mode == "install-source" and dest.name.startswith("pgdg.list.")):
        dest.write_text("partial-install")
        sys.exit(34)
    shutil.copyfile(source, dest)
    dest.chmod(0o644)
elif name == "mv":
    assert args[:2] == ["-fT", "--"]
    source, dest = target(args[2]), target(args[3])
    if mode == "rename" or (mode == "rename-source" and dest.name == "pgdg.list"): sys.exit(35)
    os.replace(source, dest)
elif name == "rm":
    assert args[0] in ("-f", "-rf") and args[1] == "--"
    path = target(args[2])
    if path.is_dir(): shutil.rmtree(path)
    else: path.unlink(missing_ok=True)
elif name == "lsb_release":
    assert args == ["-cs"]
    if mode == "codename": sys.exit(36)
    print("bookworm")
elif name == "pg_dump":
    assert args == ["--version"]
    if mode == "version-command": sys.exit(37)
    print("pg_dump (PostgreSQL) " + ("16.4" if mode == "wrong-major" or pathlib.Path(sys.argv[0]).parent.name == "fakebin" else "18.6"))
else:
    raise AssertionError(name)
'''

PASS = 0

def ok(message):
    global PASS
    PASS += 1
    print(f"ok: {message}")

# Pin the live production default: db-backup.yml runs the script with no
# PGDG_CLIENT_BIN override, so a stale default would fail the nightly backup
# while every override-based case above still passes (mutant M1).
HELPER_TEXT = HELPER.read_text()
assert '${PGDG_CLIENT_BIN:-/usr/lib/postgresql/18/bin}' in HELPER_TEXT, "script default must be pg 18"
assert 'postgresql-client-18' in HELPER_TEXT, "script must install pg 18 client"
assert 'postgresql-client-17' not in HELPER_TEXT and '/17/bin' not in HELPER_TEXT, "stale pg 17 default"
assert 'PGDG_FINGERPRINT="B97B0AFCAA1A47F044F244A07FCC7D46ACCC4CF8"' in HELPER_TEXT, "script must pin the full PGDG fingerprint"
ok("script default installs/selects pg_dump 18 and pins the PGDG fingerprint")
WORKFLOW_TEXT = (ROOT / ".github/workflows/db-backup.yml").read_text()
assert 'PGDG_CLIENT_BIN' not in WORKFLOW_TEXT, "workflow must use the script default client"
assert 'bash bin/backup-bootstrap.sh' in WORKFLOW_TEXT, "workflow must run the bootstrap script"
ok("workflow uses the script default client with no override")

PROOF_WORKFLOW_TEXT = (ROOT / ".github/workflows/backup-restore-proof.yml").read_text()
assert 'image: postgres:18' in PROOF_WORKFLOW_TEXT, "restore proof service must use postgres 18"
assert 'sudo apt-get install -y -qq --no-install-recommends postgresql-client-18' in PROOF_WORKFLOW_TEXT, "restore proof must install pg 18 client"
assert 'PG18_BIN=/usr/lib/postgresql/18/bin' in PROOF_WORKFLOW_TEXT, "restore proof must select pg 18 binaries"
assert 'version="$($PG18_BIN/$client --version)"' in PROOF_WORKFLOW_TEXT, "restore proof must invoke explicit pg 18 binaries"
assert 'must be PostgreSQL 18' in PROOF_WORKFLOW_TEXT, "restore proof must assert client major 18"
assert 'echo "$PG18_BIN" >> "$GITHUB_PATH"' in PROOF_WORKFLOW_TEXT, "restore proof must select pg 18 on later steps"
assert 'postgres:17' not in PROOF_WORKFLOW_TEXT and 'postgresql-client-17' not in PROOF_WORKFLOW_TEXT, "stale pg 17 restore proof"
ok("restore proof pins PostgreSQL 18 server and explicitly asserts PG18 clients")

with tempfile.TemporaryDirectory(prefix="backup-bootstrap-", dir=os.environ.get("PAPERCLIP_RUN_SCRATCH_DIR") or os.environ.get("PAPERCLIP_SCRATCH_DIR")) as tmp:
    root = Path(tmp)
    for directory in ("fakebin", "scratch", "keyrings", "sources", "client18"):
        (root / directory).mkdir()
    stub = root / "stub"
    stub.write_text(STUB)
    stub.chmod(0o755)
    for name in ("sudo", "apt-get", "curl", "gpg", "mktemp", "install", "mv", "rm", "lsb_release", "pg_dump"):
        (root / "fakebin" / name).symlink_to(stub)
    (root / "client18/pg_dump").symlink_to(stub)
    keyring = root / "keyrings/pgdg.gpg"
    source = root / "sources/pgdg.list"
    sentinel = root / "keyrings/other.gpg"
    sentinel.write_text("unrelated-key")
    github_path = root / "github-path"
    env = {**os.environ, "STUB_ROOT": str(root), "PATH": f"{root / 'fakebin'}:{os.environ['PATH']}",
           "PGDG_KEYRING": str(keyring), "PGDG_SOURCE_LIST": str(source),
           "PGDG_CLIENT_BIN": str(root / "client18"), "GITHUB_PATH": str(github_path)}

    def run(mode=""):
        for path in (root / "calls", root / "apt-count", github_path):
            path.unlink(missing_ok=True)
        result = subprocess.run(["bash", str(HELPER)], env={**env, "FAIL_AT": mode},
                                stdin=subprocess.DEVNULL, capture_output=True, text=True,
                                start_new_session=True, timeout=10)
        calls = [json.loads(line) for line in (root / "calls").read_text().splitlines()]
        assert sentinel.read_text() == "unrelated-key"
        assert not list((root / "keyrings").glob("*.tmp.*"))
        assert not list((root / "sources").glob("*.tmp.*"))
        assert not list((root / "scratch").iterdir())
        return result, calls

    # Reproduce the old command's existing-file/no-tty boundary using the stub.
    keyring.write_text("old-key")
    legacy = subprocess.run(["gpg", "--dearmor", "-o", str(keyring)], env=env,
                            stdin=subprocess.DEVNULL, capture_output=True, text=True,
                            start_new_session=True, timeout=10)
    assert legacy.returncode == 2 and "would prompt" in legacy.stderr
    assert keyring.read_text() == "old-key"
    ok("legacy direct-output command fails on existing keyring without tty")

    # The first run also starts with an existing synthetic keyring.
    for number in (1, 2):
        result, calls = run()
        assert result.returncode == 0, result.stderr
        assert result.stdout.strip() == "pg_dump (PostgreSQL) 18.6"
        assert keyring.read_text() == "binary-key" and keyring.stat().st_mode & 0o777 == 0o644
        assert source.read_text() == f"deb [signed-by={keyring}] http://apt.postgresql.org/pub/repos/apt bookworm-pgdg main\n"
        assert github_path.read_text() == str(root / "client18") + "\n"
        assert [c[1:] for c in calls if c[0] == "apt-get"] == [
            ["update", "-y"], ["install", "-y", "curl", "ca-certificates", "gnupg", "lsb-release"],
            ["update", "-y"], ["install", "-y", "postgresql-client-18"]]
        ok(f"run {number} replaces existing keyring without tty or prompts; installs/selects pg_dump 18")

    # Replacing the keyring must not follow a pre-existing destination symlink.
    keyring.unlink()
    keyring.symlink_to(sentinel)
    result, _ = run()
    assert result.returncode == 0 and not keyring.is_symlink(), result.stderr
    ok("keyring replacement leaves unrelated symlink target untouched")

    expected_codes = {"apt-1": 31, "apt-2": 31, "apt-3": 31, "apt-4": 31,
                      "download": 32, "invalid-key": 38, "key-validation": 38, "dearmor": 33,
                      "wrong-fingerprint": 1, "extra-key": 1,
                      "empty-key": 1, "install": 34, "install-source": 34,
                      "rename": 35, "rename-source": 35, "codename": 36,
                      "version-command": 37, "wrong-major": 1}
    for mode, code in expected_codes.items():
        keyring.write_text("old-key")
        source.write_text("old-source")
        result, calls = run(mode)
        assert result.returncode == code, (mode, result.returncode, result.stderr)
        assert not github_path.exists(), mode
        if mode in ("apt-1", "apt-2", "download", "invalid-key", "key-validation", "wrong-fingerprint", "extra-key", "dearmor", "empty-key", "install", "rename"):
            assert keyring.read_text() == "old-key" and source.read_text() == "old-source", mode
        if mode in ("install-source", "rename-source", "codename"):
            assert source.read_text() == "old-source", mode
        if mode in ("download", "invalid-key", "key-validation", "wrong-fingerprint", "extra-key", "dearmor", "empty-key", "install", "install-source", "rename", "rename-source", "codename"):
            assert not any(c[:3] == ["apt-get", "install", "-y"] and c[-1] == "postgresql-client-18" for c in calls), mode
        ok(f"{mode} fails hard, cleans scratch and does not publish client PATH")

print(f"{PASS} assertions passed (offline stubs only)")

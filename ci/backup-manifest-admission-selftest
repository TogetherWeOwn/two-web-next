#!/usr/bin/env python3
"""Local-only R2/pg_dump fixtures: never use Wrangler, databases or real stores."""

import json
import os
from pathlib import Path
import subprocess
import tempfile
import unittest

ROOT = Path(__file__).resolve().parent.parent
PREFIX = "neon/staging-staging"
DAILY = PREFIX + "-20260930T000000Z.dump"
NEW = PREFIX + "-20261001T123456Z.dump"
WEEKLY = PREFIX + "-20260930T000000Z-weekly-20261001T123456Z.dump"
FOREIGN = "neon/main-main-20260901T000000Z.dump"
RECEIPT_SUFFIX = ".digest.json"
MANIFEST = PREFIX + "/MANIFEST.txt"

FAKE_R2 = r'''#!/usr/bin/env python3
import json, os, pathlib, shutil, sys
args = sys.argv[1:]
assert args[:2] == ["r2", "object"]
op, address = args[2:4]
assert address.startswith("test-bucket/")
assert "--remote" in args
assert args[args.index("--jurisdiction") + 1] == "eu"
key = address.removeprefix("test-bucket/")
root = pathlib.Path(os.environ["FAKE_R2"])
dest = root / key
assert dest.resolve().is_relative_to(root.resolve())
with open(os.environ["FAKE_LOG"], "a") as log:
    log.write(json.dumps([op, key]) + "\n")
file = pathlib.Path(args[args.index("--file") + 1]) if "--file" in args else None
if op == "get":
    if key.endswith("/MANIFEST.txt") and os.environ.get("FAKE_FAILURE"):
        # A failed download may still create partial local output.
        if file:
            file.write_text("partial inventory")
        print(os.environ["FAKE_FAILURE"], file=sys.stderr)
        sys.exit(1)
    if not dest.is_file():
        print("\x1b[31m✘ [ERROR]\x1b[0m The specified key does not exist.", file=sys.stderr)
        sys.exit(1)
    if file:
        shutil.copyfile(dest, file)
        if key.endswith("/MANIFEST.txt") and os.environ.get("FAKE_BAD_PROOF"):
            puts = [json.loads(line) for line in pathlib.Path(os.environ["FAKE_LOG"]).read_text().splitlines()]
            if ["put", key] in puts:
                file.write_text(os.environ["FAKE_BAD_PROOF"])
    else:
        assert "--pipe" in args
        sys.stdout.buffer.write(dest.read_bytes())
elif op == "put":
    assert "--force" in args and file
    dest.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(file, dest)
elif op == "delete":
    assert "--force" in args
    dest.unlink()
else:
    raise AssertionError("unexpected fake R2 operation")
'''
FAKE_DUMP = r'''#!/usr/bin/env python3
import pathlib, sys
pathlib.Path(sys.argv[sys.argv.index("-f") + 1]).write_bytes(b"SYNTHETIC-DUMP\n")
'''
FAKE_DATE = '''#!/usr/bin/env python3
import sys
assert sys.argv[1:] == ["-u", "+%Y%m%dT%H%M%SZ"]
print("20261001T123456Z")
'''


class ManifestAdmission(unittest.TestCase):
    def setUp(self):
        self.temp = tempfile.TemporaryDirectory(dir=os.environ.get("PAPERCLIP_RUN_SCRATCH_DIR"))
        self.addCleanup(self.temp.cleanup)
        self.base = Path(self.temp.name)
        self.store = self.base / "r2"
        self.store.mkdir()
        self.log = self.base / "calls.jsonl"
        self.log.touch()
        fakebin = self.base / "fakebin"
        fakebin.mkdir()
        for name, text in (("r2", FAKE_R2), ("pg_dump", FAKE_DUMP), ("date", FAKE_DATE)):
            script = fakebin / name
            script.write_text(text)
            script.chmod(0o755)
        # Pass only synthetic configuration; no inherited store/DB credentials.
        self.env = {
            "PATH": str(fakebin) + ":/usr/bin:/bin",
            "TMPDIR": str(self.base),
            "WRANGLER_BIN": str(fakebin / "r2"),
            "DATABASE_URL": "postgres://fixture@fake-host/fixture",
            "BACKUP_BUCKET": "test-bucket",
            "BACKUP_PREFIX": "neon",
            "BACKUP_JURISDICTION": "eu",
            "FAKE_R2": str(self.store),
            "FAKE_LOG": str(self.log),
        }

    def seed(self, keys, receipts=()):
        for key in keys:
            if key:
                dest = self.store / key
                dest.parent.mkdir(parents=True, exist_ok=True)
                dest.write_bytes(b"SYNTHETIC-ARCHIVE\n")
        # Receipts are real digest sidecars (docs/backup-integrity.md), written
        # by the repo's own helper over the synthetic archive bytes.
        for key in receipts:
            receipt = self.store / (key + RECEIPT_SUFFIX)
            subprocess.run([str(ROOT / "bin/backup/integrity-helper"), "write",
                            str(self.store / key), key, str(receipt)],
                           check=True, capture_output=True)
        manifest = self.store / MANIFEST
        manifest.parent.mkdir(parents=True, exist_ok=True)
        manifest.write_text("".join(key + "\n" for key in [*keys, *(k + RECEIPT_SUFFIX for k in receipts)]))

    def run_backup(self, command, *args, branch="staging"):
        return subprocess.run(["bash", str(ROOT / "bin/neon-backup.sh"), command, branch, *args],
                              cwd=ROOT, env=self.env, capture_output=True, text=True)

    def calls(self):
        return [json.loads(line) for line in self.log.read_text().splitlines()]

    def snapshot(self):
        return {str(p.relative_to(self.store)): p.read_bytes()
                for p in self.store.rglob("*") if p.is_file()}

    def refuse_without_mutation(self, command):
        before = self.snapshot()
        self.log.write_text("")
        result = self.run_backup(command)
        self.assertNotEqual(result.returncode, 0, result.stdout)
        self.assertEqual(self.snapshot(), before)
        self.assertFalse(any(op in ("put", "delete") for op, _ in self.calls()), self.calls())

    def test_transport_and_auth_failures_never_initialize(self):
        self.seed([DAILY])
        for failure in ("✘ [ERROR] Authentication error [code: 10000]",
                        "✘ [ERROR] fetch failed", "", "✘ [ERROR] HTTP 404 bucket not found",
                        "warning: The specified key does not exist.",
                        "✘ [ERROR] The specified key does not exist.\n✘ [ERROR] Authentication error"):
            for command in ("backup", "promote-weekly", "rotate", "check"):
                with self.subTest(failure=failure, command=command):
                    # Whitespace is still a failing, unclassified transport result.
                    self.env["FAKE_FAILURE"] = failure or " "
                    self.refuse_without_mutation(command)

    def test_explicit_missing_initializes_backup_only(self):
        for command in ("promote-weekly", "rotate", "check"):
            self.refuse_without_mutation(command)
        result = self.run_backup("backup")
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual((self.store / MANIFEST).read_text(), NEW + "\n" + NEW + RECEIPT_SUFFIX + "\n")
        self.assertEqual((self.store / NEW).read_bytes(), b"SYNTHETIC-DUMP\n")

    def test_failed_read_with_notfound_diagnostic_discards_partial_file(self):
        self.env["FAKE_FAILURE"] = "✘ [ERROR] The specified key does not exist."
        # Only the initial GET fails; the proof GET must use the uploaded manifest.
        stub = Path(self.env["WRANGLER_BIN"])
        stub.write_text(FAKE_R2.replace('and os.environ.get("FAKE_FAILURE"):',
                                       'and not dest.is_file() and os.environ.get("FAKE_FAILURE"):'))
        result = self.run_backup("backup")
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual((self.store / MANIFEST).read_text(), NEW + "\n" + NEW + RECEIPT_SUFFIX + "\n")

    def test_valid_append_preserves_daily_and_weekly(self):
        old_weekly = PREFIX + "-20260901T000000Z-weekly-20260907T000000Z.dump"
        self.seed([old_weekly, DAILY])
        result = self.run_backup("backup")
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual((self.store / MANIFEST).read_text().splitlines(),
                         sorted([old_weekly, DAILY, NEW, NEW + RECEIPT_SUFFIX]))

    def test_empty_manifest_is_valid(self):
        self.seed([])
        self.assertEqual(self.run_backup("backup").returncode, 0)

    def test_missing_final_newline_can_append(self):
        self.seed([DAILY])
        (self.store / MANIFEST).write_text(DAILY)
        self.assertEqual(self.run_backup("backup").returncode, 0)
        self.assertEqual((self.store / MANIFEST).read_text().splitlines(), [DAILY, NEW, NEW + RECEIPT_SUFFIX])

    def test_invalid_entries_reject_entire_inventory(self):
        bad_keys = [FOREIGN, DAILY, "arbitrary.dump", PREFIX + "-20260230T000000Z.dump",
                    PREFIX + "-20260930T250000Z.dump", DAILY + "-weekly-20261001T000000Z.dump",
                    PREFIX + "-20260930T000000Z-weekly-invalid.dump",
                    PREFIX + "-20260930T000000Z.dump ", DAILY + "\r", DAILY + "\v" + NEW,
                    "", "../main.dump",
                    # Receipt sidecars are admitted only for a valid branch archive.
                    FOREIGN + RECEIPT_SUFFIX, PREFIX + "-20260930T000000Z" + RECEIPT_SUFFIX,
                    DAILY + RECEIPT_SUFFIX + ".bak", DAILY + RECEIPT_SUFFIX + RECEIPT_SUFFIX,
                    DAILY + RECEIPT_SUFFIX + "\r"]
        for key in bad_keys:
            for command in ("backup", "promote-weekly", "rotate", "check"):
                with self.subTest(key=key, command=command):
                    # Write untrusted manifest lines, not objects for unsafe names.
                    self.seed([DAILY])
                    (self.store / MANIFEST).write_text(DAILY + "\n" + key + "\n")
                    self.refuse_without_mutation(command)

    def test_foreign_weekly_is_rejected_before_rotation(self):
        self.seed([DAILY, "neon/main-main-20260901T000000Z-weekly-20260907T000000Z.dump"])
        self.refuse_without_mutation("rotate")

    def test_duplicate_weekly_is_rejected(self):
        self.seed([DAILY, WEEKLY, WEEKLY])
        self.refuse_without_mutation("promote-weekly")
        self.refuse_without_mutation("rotate")

    def test_generated_backup_duplicate_rejected_before_upload(self):
        self.seed([NEW])
        self.refuse_without_mutation("backup")

    def test_generated_weekly_duplicate_rejected_before_upload(self):
        self.seed([DAILY, WEEKLY])
        self.refuse_without_mutation("promote-weekly")

    def test_invalid_utf8_is_rejected(self):
        self.seed([DAILY])
        (self.store / MANIFEST).write_bytes(b"\xff\n")
        for command in ("backup", "promote-weekly", "rotate", "check"):
            self.refuse_without_mutation(command)

    def test_valid_promotion_uses_actual_key_pattern(self):
        self.seed([DAILY], receipts=[DAILY])
        result = self.run_backup("promote-weekly")
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual((self.store / WEEKLY).read_bytes(), (self.store / DAILY).read_bytes())
        self.assertEqual((self.store / MANIFEST).read_text().splitlines(),
                         sorted([DAILY, DAILY + RECEIPT_SUFFIX, WEEKLY, WEEKLY + RECEIPT_SUFFIX]))

    def test_duplicate_receipt_is_rejected(self):
        self.seed([DAILY], receipts=[DAILY])
        with (self.store / MANIFEST).open("a") as manifest:
            manifest.write(DAILY + RECEIPT_SUFFIX + "\n")
        for command in ("backup", "promote-weekly", "rotate", "check"):
            with self.subTest(command=command):
                self.refuse_without_mutation(command)

    def test_foreign_receipt_is_rejected_before_rotation(self):
        self.seed([DAILY])
        (self.store / MANIFEST).write_text(DAILY + "\n" + FOREIGN + RECEIPT_SUFFIX + "\n")
        self.refuse_without_mutation("rotate")

    def test_retention_and_dry_run(self):
        dailies = [PREFIX + f"-202609{day:02}T000000Z.dump" for day in range(1, 10)]
        weeklies = [PREFIX + f"-202608{day:02}T000000Z-weekly-202609{day:02}T000000Z.dump"
                    for day in range(1, 7)]
        self.seed(dailies + weeklies)
        before = self.snapshot()
        result = self.run_backup("rotate", "--dry-run")
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual(self.snapshot(), before)
        self.assertFalse(any(op != "get" for op, _ in self.calls()))
        result = self.run_backup("rotate")
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual((self.store / MANIFEST).read_text().splitlines(), sorted(dailies[-7:] + weeklies[-4:]))
        self.assertEqual([key for op, key in self.calls() if op == "delete"], dailies[:2] + weeklies[:2])
        self.assertEqual(self.run_backup("check").returncode, 0)

    def test_selected_branch_and_prefix(self):
        self.env["BACKUP_PREFIX"] = "custom/prefix"
        result = self.run_backup("backup", branch="main")
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual((self.store / "custom/prefix/main-main/MANIFEST.txt").read_text(),
                         "custom/prefix/main-main-20261001T123456Z.dump\n"
                         "custom/prefix/main-main-20261001T123456Z.dump" + RECEIPT_SUFFIX + "\n")

    def test_check_reads_unterminated_last_key(self):
        self.seed([DAILY])
        (self.store / MANIFEST).write_text(DAILY)
        (self.store / DAILY).unlink()
        self.refuse_without_mutation("check")
        self.assertIn(["get", DAILY], self.calls())

    def test_proof_is_also_admitted(self):
        self.seed([DAILY])
        self.env["FAKE_BAD_PROOF"] = NEW + "\n" + FOREIGN + "\n"
        result = self.run_backup("backup")
        self.assertNotEqual(result.returncode, 0)


if __name__ == "__main__":
    unittest.main(verbosity=2)

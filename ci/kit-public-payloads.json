      "tests": ["Kit GET /hotzones/:signal anonymous payloads"]
    },
    {
      "id": "kit-payload-hotzones-games",
      "route": "GET /hotzones/games",
      "binding": "web/src/routes/hotzones/[signal]/+page.server.ts",
      "tests": ["Kit GET /hotzones/:signal anonymous payloads"]

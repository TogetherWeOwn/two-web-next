  "outOfScope": [
    {
      "route": "GET /e/:key",
      "binding": "web/src/routes/e/[key]/+page.server.ts",
      "reason": "Hono-owned member-read boundary (detail + neighbors); covered by the Hono payload audit, not this contract."
    },
    {
      "route": "GET /e/:key",
      "binding": "web/src/routes/e/[key]/+layout.server.ts",
      "reason": "Layout half of the Hono-owned /e/:key boundary (see above)."
    },
    {
      "route": "GET /auth/recover",
      "binding": "web/src/routes/auth/recover/+page.server.ts",
      "reason": "Hono-owned transient outcome page (journey writes + /join/callback outcomes stay Hono)."
    },
    {
      "route": "*",
      "binding": "web/src/routes/[...path]/+server.ts",
      "reason": "Strangler catch-all: unrouted paths go to the Hono app unchanged (Hono surface)."
    }
  ]

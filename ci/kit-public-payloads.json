    },
    {
      "id": "kit-payload-join",
      "route": "GET /join",
      "binding": "web/src/routes/join/+page.server.ts",
      "tests": ["Kit GET /join anonymous payload"]
    },
    {
      "id": "kit-payload-hotzones",
      "route": "GET /hotzones",
      "binding": "web/src/routes/hotzones/+page.server.ts",
      "tests": ["Kit GET /hotzones anonymous payload"]
    },
    {
      "id": "kit-payload-hotzones-joins",
      "route": "GET /hotzones/joins",

+func TestDetectAbsentReleaseNotFound(t *testing.T) {
+	mockReleaseStatus(t, http.StatusNotFound)
+	stdout := &bytes.Buffer{}
+	stderr := &bytes.Buffer{}
+	f := filepath.Join("testdata", "registry", "empty_slug.json")
+	status := newGen(stdout, stderr, io.Discard).run([]string{"test", "-d", "-r", f})
+	if status != 0 {
+		t.Fatal("exit status is not 0:", status)
+	}
+	if stdout.String() != "No new release was found\n" || stderr.Len() != 0 {
+		t.Fatalf("unexpected absent-release result: stdout=%q stderr=%q", stdout.String(), stderr.String())
+	}
+}

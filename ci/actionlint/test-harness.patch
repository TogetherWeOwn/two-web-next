+type releaseStatusTransport func(*http.Request) (*http.Response, error)
+
+func (f releaseStatusTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	return f(req)
+}
+
+func mockReleaseStatus(t *testing.T, status int) {
+	t.Helper()
+	previous := http.DefaultTransport
+	var calls int32
+	http.DefaultTransport = releaseStatusTransport(func(req *http.Request) (*http.Response, error) {
+		if req.Method != http.MethodHead || req.URL.String() != "https://raw.githubusercontent.com//v2/action.yml" {
+			return nil, fmt.Errorf("unexpected fixture request: %s %s", req.Method, req.URL)
+		}
+		atomic.AddInt32(&calls, 1)
+		return &http.Response{
+			StatusCode: status,
+			Status:     fmt.Sprintf("%d %s", status, http.StatusText(status)),
+			Header:     make(http.Header),
+			Body:       io.NopCloser(strings.NewReader("")),
+			Request:    req,
+		}, nil
+	})
+	t.Cleanup(func() {
+		http.DefaultTransport = previous
+		if got := atomic.LoadInt32(&calls); got != 1 {
+			t.Errorf("expected one intercepted release request, got %d", got)
+		}
+	})
+}

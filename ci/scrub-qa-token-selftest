    def test_mixed_hit_and_withheld_prints_both_notices(self):
        hit = self.write_tree("hit.log", b"prefix " + MARKER + b" suffix")
        raw = make_zip([
            ("trace.network", b"clean " * 200, zipfile.ZIP_DEFLATED),
        ])
        truncated = raw[: len(raw) // 2]
        self.assertNotIn(MARKER, truncated)
        unproven = self.write_tree("truncated-clean.zip", truncated)
        result = self.run_scrubber()
        self.assertEqual(result.returncode, 1, result.stdout + result.stderr)
        self.assert_removed(hit)
        self.assert_removed(unproven)
        self.assertIn("swept=true", self.swept())
        self.assert_no_leak(result)
        combined = result.stdout + result.stderr
        self.assertIn("was found", combined)
        self.assertIn("withheld from the upload", combined)

    def test_broad_exception_as_clean_fallback_is_gone(self):
        # Reintroducing `except ...: return None` around the whole member loop
        # would classify this file clean. The fixture must be removed, so the
        # fallback cannot come back without failing this test.
        clean = make_zip([
            ("first.txt", b"hello unreadable", zipfile.ZIP_STORED),
            ("second.txt", b"prefix " + MARKER + b" suffix", zipfile.ZIP_DEFLATED),
        ])
        raw = patch_first_member_method(clean, 99)
        target = self.write_tree("fallback-probe.zip", raw)
        result = self.run_scrubber()
        self.assert_removed(target)
        self.assertEqual(result.returncode, 1, result.stdout + result.stderr)
        self.assertIn("swept=true", self.swept())



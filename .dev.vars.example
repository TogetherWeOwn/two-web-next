# Copy to .dev.vars for `wrangler dev`. Never commit .dev.vars.
# TrustHosts has no loopback exemption: local requests must match this hostname.
APP_URL=http://localhost:8787
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# 32+ random bytes, e.g. `openssl rand -base64 48`
SESSION_SECRET=
# Local dev DB (agent-testdb) for `npm run db:migrate` and the live db test.
# Without it sessions fall back to a per-request memory store and cannot
# persist: every view is a guest. Staging/prod use the Hyperdrive binding
# (W1/S1) through the same Sql surface instead.
DATABASE_URL=postgres://agent_test@agent-testdb:5432/two_web_next
# Moderator snowflake role IDs, comma-separated (never names). Blank = nobody.
DISCORD_MODERATOR_ROLE_IDS=
# Staging-only QA seam. Unset everywhere else: the route 404s without it.
QA_AUTH_TOKEN=
# W16 pre-flip probes (TOG-10112). Values only — never commit the real ones.
# The role probe reads DISCORD_MODERATOR_ROLE_IDS above. The staging smoke
# signs with BOT_SHARED_SECRET against the staging bot only and refuses the
# host named by BOT_PRODUCTION_URL. In CI these stay unset (fixture selftest).
BOT_ENDPOINT_URL=
BOT_SHARED_SECRET=
BOT_KEY_ID=
BOT_PRODUCTION_URL=
# CSP violation sink sampling (TOG-10107): fraction of valid reports logged.
# Unset or unparseable = 1.0 (log everything). Lower it if report volume
# ever outweighs the signal.
# CSP_REPORT_SAMPLE_RATE=1.0

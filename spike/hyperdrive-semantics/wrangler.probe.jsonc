// Local control leg only. No Hyperdrive binding: Miniflare's HyperdriveSchema
// requires a password, which the passwordless agent-testdb container cannot
// satisfy (and no credential may be introduced). The Worker receives the same
// pinned test-container target as a plain `vars` string instead. Remote
// dev/deploy is prohibited. This does not exercise Hyperdrive pooling.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "two-web-next-w1-local-control",
  "main": "./probe-worker.ts",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [],
  "vars": {
    "TEST_DB_CONNECTION_STRING": "postgres://agent_test@agent-testdb:5432/agent_test"
  }
}

// two-web-jobs: queue consumers + cron triggers only, no fetch handler (TOG-12247 spike,
// staging handoff). Shares src/db and the domain modules with the web
// front; one wrangler config per Worker.
//
// Staging (top level) consumes two-sync-event / two-internal-action and owns
// both crons; wrangler.jsonc (two-web-next) only produces after the handoff.
// A queue has exactly one consumer and a cron exactly one owner:
// test/jobs-worker-config.test.ts pins the split. Preview envs stay on their
// own queues. Deploy order is tail, then web, then detach, then jobs: the
// jobs deploy attaches its consumers, so it must run after the web consumers
// are detached (see .github/workflows/deploy.yml and docs/jobs-handoff.md).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "two-web-jobs",
  "main": "src/jobs-worker.ts",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Staging database is PlanetScale us-east-1 and every statement is a round
  // trip through Hyperdrive: run the jobs Worker beside it, like the web Worker.
  "placement": { "region": "aws:us-east-1" },
  // Page jobs traces through the same staging Tail pager as the web Worker.
  // Wrangler never inherits this into env.preview (which pages nothing).
  "tail_consumers": [{ "service": "two-web-next-alerts" }],
  // Release fields on queue.failing lines: the deploy tags this Worker's
  // Versions with the same commit SHA as the web Worker.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Preserve operator-set vars across redeploys; secrets are retained by
  // Wrangler separately and never live in this file.
  "keep_vars": true,
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["*/10 * * * *", "0 0 * * *"] },
  "queues": {
    "producers": [
      { "queue": "two-sync-event", "binding": "SYNC_EVENT_QUEUE" },
      { "queue": "two-internal-action", "binding": "INTERNAL_ACTION_QUEUE" }
    ],
    // Terminal outcomes are acked by the consumer; max_retries is only a backstop above the largest `tries`.
    "consumers": [
      {
        "queue": "two-sync-event",
        "max_retries": 10,
        "max_batch_size": 10,
        "max_batch_timeout": 5
      },
      {
        "queue": "two-internal-action",
        "max_retries": 10,
        "max_batch_size": 10,
        "max_batch_timeout": 5
      }
    ]
  },
  "hyperdrive": [{ "binding": "DB", "id": "1d48a54abd3444009b7067c03c63ff9f" }],
  "vars": {
    "APP_URL": "https://next.togetherweown.com"
  },
  "env": {
    // Spike evidence target: its own queues, the staging Hyperdrive, no route, no
    // workers.dev URL and no tail consumer (no alert noise). Tear down with
    // `npx wrangler delete --config wrangler.jobs.jsonc --env preview` and
    // `npx wrangler queues delete <name>` for both queues below.
    "preview": {
      "name": "two-web-jobs-preview",
      "workers_dev": false,
      "preview_urls": false,
      // Reconcile only (src/jobs/constants.ts RECONCILE_CRON): prune is a daily
      // midnight delete that staging's own cron already runs on this database.
      "triggers": { "crons": ["*/10 * * * *"] },
      "queues": {
        "producers": [
          { "queue": "two-web-jobs-preview-sync-event", "binding": "SYNC_EVENT_QUEUE" },
          { "queue": "two-web-jobs-preview-internal-action", "binding": "INTERNAL_ACTION_QUEUE" }
        ],
        "consumers": [
          {
            "queue": "two-web-jobs-preview-sync-event",
            "max_retries": 10,
            "max_batch_size": 10,
            "max_batch_timeout": 5
          },
          {
            "queue": "two-web-jobs-preview-internal-action",
            "max_retries": 10,
            "max_batch_size": 10,
            "max_batch_timeout": 5
          }
        ]
      },
      "hyperdrive": [{ "binding": "DB", "id": "1d48a54abd3444009b7067c03c63ff9f" }],
      // Never the staging APP_URL: qaEnabled() stays false, so an alert-probe
      // message is acked as done and can never page.
      "vars": {
        "APP_URL": "https://two-web-jobs-preview.invalid"
      }
    },
    // Production jobs owner: consumes the production queues and owns both
    // production crons, mirroring the staging split (one consumer per queue,
    // one cron owner). The web env.production only produces after the
    // one-time transfer (docs/production-jobs-handoff.md); test/jobs-worker-config.test.ts
    // pins the split. Queues, Hyperdrive and secrets are production-only:
    // never a staging queue, the staging database, or a staging secret.
    "production": {
      "name": "two-web-jobs-production",
      "workers_dev": false,
      "preview_urls": false,
      // No routes: without routes or custom domains a jobs deploy never
      // touches domain provisioning, so attaching consumers/crons here is
      // domain-safe (the web production apex stays untouched).
      "placement": { "mode": "off" },
      // Page production jobs traces through the production Tail pager, like
      // the web production Worker. Never inherited from the top level.
      "tail_consumers": [{ "service": "two-web-next-alerts-production" }],
      // Not inherited from the top level: without this copy the jobs
      // production log lines carry no build SHA.
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      // Same schedules as staging (src/jobs/constants.ts): reconcile every
      // ten minutes, prune daily at midnight.
      "triggers": { "crons": ["*/10 * * * *", "0 0 * * *"] },
      "queues": {
        "producers": [
          { "queue": "two-web-next-production-sync-event", "binding": "SYNC_EVENT_QUEUE" },
          {
            "queue": "two-web-next-production-internal-action",
            "binding": "INTERNAL_ACTION_QUEUE"
          }
        ],
        // Same backstops as staging and the pre-transfer web production
        // consumer: terminal outcomes are acked by the consumer.
        "consumers": [
          {
            "queue": "two-web-next-production-sync-event",
            "max_retries": 10,
            "max_batch_size": 10,
            "max_batch_timeout": 5
          },
          {
            "queue": "two-web-next-production-internal-action",
            "max_retries": 10,
            "max_batch_size": 10,
            "max_batch_timeout": 5
          }
        ]
      },
      // Production database: the same production Hyperdrive the web
      // production Worker reads, never the staging one. No BOT_DB: the jobs
      // Worker never reads bot views.
      "hyperdrive": [{ "binding": "DB", "id": "7489f6ad630042148cdef83602f27b8a" }],
      // Least-required vars: production APP_URL only. qaEnabled() requires
      // the staging APP_URL, so it stays false here. BOT_* and QA_AUTH_TOKEN
      // are Operator-provisioned secrets, never in this file; QA_AUTH_TOKEN
      // stays unprovisioned on production (staging probe only).
      "vars": {
        "APP_URL": "https://togetherweown.com"
      }
    }
  }
}
